NODE_ENV=development
PORT=6001
APP_ORIGIN=http://localhost:6001
MONGODB_URI=mongodb://127.0.0.1:27017/noticeai?replicaSet=rs0
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_DIR=./data
# Use gridfs for persistent uploads on free Render hosting; filesystem needs a disk.
UPLOAD_STORAGE=filesystem
TRUST_PROXY=0

# Optional integrations — never commit real values
OPENAI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=
PAYU_KEY=
PAYU_SALT=
PAYU_IS_LIVE=false

# Temporary provisioning inputs; remove after running npm run admin:create
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional import of private legacy files
LEGACY_UPLOAD_DIR=
