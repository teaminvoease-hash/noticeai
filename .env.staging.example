APP_ENV=staging
NODE_ENV=development
PORT=6080
APP_ORIGIN=http://localhost:6080
MONGODB_URI=mongodb://127.0.0.1:27120/noticeai_staging?replicaSet=rs0&directConnection=true
STAGING_DATABASE_NAME=noticeai_staging
SESSION_COOKIE_NAME=resolvex.staging.sid
SESSION_SECRET=replace-with-a-new-staging-only-random-secret-of-at-least-32-characters
UPLOAD_STORAGE=gridfs
AI_FEATURES_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PAYU_IS_LIVE=false
STAGING_ALLOW_EXTERNAL_DELIVERY=false

# Do not enable in production without independent legal review of the actual model.
LEGAL_MODEL_REVIEW_APPROVED=false
PUBLIC_PRICE_DISPLAY_APPROVED=false
