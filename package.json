{
  "name": "noticeai-complete",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --config client/vite.config.mjs\"",
    "build": "vite build --config client/vite.config.mjs",
    "test": "node --test tests/*.unit.cjs",
    "admin:create": "node server/scripts/create-admin.js",
    "test:integration": "node --test --test-concurrency=1 tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "dev:staging": "ENV_FILE=.env.staging concurrently -k \"node --watch server/index.js\" \"vite --config client/vite.config.mjs\"",
    "staging:up": "docker compose --env-file .env.staging.runtime -f compose.staging.yml up --build -d",
    "staging:down": "docker compose --env-file .env.staging.runtime -f compose.staging.yml down",
    "staging:prepare": "node server/scripts/create-staging-env.js",
    "build:vercel": "npm run typecheck && npm run build && node server/scripts/build-vercel.cjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@reduxjs/toolkit": "^2.5.0",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "connect-mongo": "^5.1.0",
    "docx": "^9.15.4",
    "dompurify": "^3.4.18",
    "dotenv": "^16.6.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "file-type": "^22.3.0",
    "helmet": "^8.1.0",
    "jspdf": "^4.2.1",
    "mammoth": "^1.13.0",
    "mongoose": "^8.19.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.6.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "quill-delta": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-quill": "npm:react-quill-new@^3.8.3",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.5",
    "sanitize-html": "^2.17.0",
    "sweetalert2": "^11.26.0",
    "tailwind-merge": "^3.7.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.12",
    "mongodb-memory-server": "^10.3.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^6.4.1"
  }
}
