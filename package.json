{
  "name": "noticeai-complete",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --config client/vite.config.mjs\"",
    "build": "vite build --config client/vite.config.mjs",
    "test": "node --test tests/*.unit.cjs",
    "admin:create": "node server/scripts/create-admin.js",
    "test:integration": "node --test --test-concurrency=1 tests/*.test.cjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.5.0",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^5.1.0",
    "dompurify": "^3.4.18",
    "dotenv": "^16.6.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "file-type": "^22.3.0",
    "helmet": "^8.1.0",
    "jspdf": "^4.2.1",
    "mongoose": "^8.19.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.6.0",
    "quill-delta": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-quill": "npm:react-quill-new@^3.8.3",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.5",
    "sanitize-html": "^2.17.0",
    "sweetalert2": "^11.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "mongodb-memory-server": "^10.3.0",
    "supertest": "^7.1.4",
    "vite": "^6.4.1"
  }
}
